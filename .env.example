# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain used for tenant subdomains: {slug}.{ROOT_DOMAIN}
# local: localhost:3000   production: yourdomain.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ---------- Supabase (from `supabase status` locally, or the dashboard) ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser. Used by webhooks and super-admin actions.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Razorpay (platform subscription billing) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------- Firebase (client) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---------- Firebase Admin (server only) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# keep the \n escapes, wrap in quotes
FIREBASE_PRIVATE_KEY=

# ---------- Cron / internal ----------
# shared secret for scheduled endpoints (trial-ending reminders etc.)
CRON_SECRET=
